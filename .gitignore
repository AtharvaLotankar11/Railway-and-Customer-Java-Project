# Ignore everything
*

# But not these files and directories
!.gitignore
!README.md
!src/
!src/**
!*.iml

# Compiled class files
*.class

# Log files
*.log

# Package Files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# IDE specific files
.idea/
*.iws
*.ipr

# Output directories
out/
target/

# Windows
Thumbs.db
Desktop.ini
desktop.ini

# Temporary files
*.tmp
*.temp